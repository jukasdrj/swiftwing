{
  "respectGitignore": true,
  "plansDirectory": ".claude/plans",
  "attribution": {
    "commit": "Co-Authored-By: Claude Code <noreply@anthropic.com>"
  },
  "fileSuggestion": {
    "type": "command",
    "command": "find swiftwing -type f \\( -name '*.swift' -o -name '*.json' -o -name '*.md' \\) 2>/dev/null"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '📱 SwiftWing iOS 26 | Epic-based development'",
            "timeout": 3000,
            "description": "Session startup reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -q 'talaria-openapi.yaml'; then echo 'WARNING: Editing committed API spec. Use ./Scripts/update-api-spec.sh instead.' >&2; fi",
            "timeout": 3000,
            "description": "Guard against accidental edits to committed OpenAPI spec"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE '\\.swift'; then echo '🔨 Swift file changed — run /build-sim to verify 0 errors, 0 warnings' >&2; fi",
            "timeout": 3000,
            "description": "Remind to build-verify after Swift edits"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Task(*)",
      "Skill(gogo)",
      "Skill(feature-dev)",
      "mcp__pal__debug",
      "mcp__pal__codereview",
      "mcp__pal__analyze",
      "mcp__pal__thinkdeep",
      "mcp__pal__chat",
      "mcp__pal__consensus",
      "WebFetch(*)",
      "WebSearch(*)"
    ]
  }
}
