{
  "respectGitignore": true,
  "plansDirectory": ".claude/plans",
  "attribution": {
    "commit": "Co-Authored-By: Claude Code <noreply@anthropic.com>"
  },
  "fileSuggestion": {
    "type": "command",
    "command": "find swiftwing -type f \\( -name '*.swift' -o -name '*.json' -o -name '*.md' \\) 2>/dev/null"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '📱 SwiftWing iOS 26 | Epic-based development'",
            "timeout": 3000,
            "description": "Session startup reminder"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Task(*)",
      "Skill(gogo)",
      "Skill(feature-dev)",
      "mcp__pal__debug",
      "mcp__pal__codereview",
      "mcp__pal__analyze",
      "mcp__pal__thinkdeep",
      "mcp__pal__chat",
      "mcp__pal__consensus",
      "WebFetch(*)",
      "WebSearch(*)"
    ]
  }
}
