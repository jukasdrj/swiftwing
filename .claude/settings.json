{
  "respectGitignore": true,
  "plansDirectory": ".claude/plans",
  "attribution": {
    "commit": "Co-Authored-By: Claude Code <noreply@anthropic.com>"
  },
  "fileSuggestion": {
    "type": "command",
    "command": "find swiftwing -type f \\( -name '*.swift' -o -name '*.json' -o -name '*.md' \\) 2>/dev/null"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '📱 SwiftWing iOS 27 | Swift 6.4'",
            "timeout": 3000,
            "description": "Session startup reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/file-edit-guard.sh\" openapi",
            "timeout": 3000,
            "description": "Guard against accidental edits to committed OpenAPI spec"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/file-edit-guard.sh\" swift",
            "timeout": 3000,
            "description": "Remind to build-verify after Swift edits"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Task(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ]
  }
}
